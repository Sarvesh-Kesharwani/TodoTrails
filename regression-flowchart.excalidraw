    {"id":"N6","type":"rectangle","x":750,"y":320,"width":350,"height":160,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"#d0ebff","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":1007,"version":1,"versionNonce":1007,"isDeleted":false,"boundElements":[{"type":"text","id":"T6"},{"id":"A6","type":"arrow"},{"id":"A7","type":"arrow"}],"updated":1730000000000,"link":null,"locked":false},
    {"id":"T6","type":"text","x":760,"y":335,"width":330,"height":130,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":2007,"version":1,"versionNonce":2007,"isDeleted":false,"boundElements":null,"updated":1730000000000,"link":null,"locked":false,"fontSize":16,"fontFamily":1,"text":"Definition:\nInput ka polynomial version (x, x², x³, ...) use karke curve fit karta hai, par parameters abhi bhi linear regression jaise hi estimate hote hain.","textAlign":"center","verticalAlign":"middle","baseline":13,"containerId":"N6","originalText":"Definition:\nInput ka polynomial version (x, x², x³, ...) use karke curve fit karta hai, par parameters abhi bhi linear regression jaise hi estimate hote hain.","lineHeight":1.25},

    {"id":"N7","type":"rectangle","x":750,"y":520,"width":350,"height":320,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"#e7f5ff","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":1008,"version":1,"versionNonce":1008,"isDeleted":false,"boundElements":[{"type":"text","id":"T7"},{"id":"A7","type":"arrow"},{"id":"A8","type":"arrow"}],"updated":1730000000000,"link":null,"locked":false},
    {"id":"T7","type":"text","x":760,"y":535,"width":330,"height":290,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":2008,"version":1,"versionNonce":2008,"isDeleted":false,"boundElements":null,"updated":1730000000000,"link":null,"locked":false,"fontSize":14,"fontFamily":1,"text":"Elaborated:\nPLR mein original features ko polynomial terms mein transform karte hain (jaise x, x², x³) aur phir ye sab ko multiple linear regression ki tarah treat karte hain. Equation: y = b0 + b1*x + b2*x² + b3*x³ + ... jahan sab coefficients linear fashion mein estimate hote hain using least squares. Ye non-linear patterns capture karta hai without actually non-linear model banane ki zarurat. Example: house price vs size — size² term add karke better curve fit milta hai jab relation straight line nahi hoti.","textAlign":"left","verticalAlign":"middle","baseline":11,"containerId":"N7","originalText":"Elaborated:\nPLR mein original features ko polynomial terms mein transform karte hain (jaise x, x², x³) aur phir ye sab ko multiple linear regression ki tarah treat karte hain. Equation: y = b0 + b1*x + b2*x² + b3*x³ + ... jahan sab coefficients linear fashion mein estimate hote hain using least squares. Ye non-linear patterns capture karta hai without actually non-linear model banane ki zarurat. Example: house price vs size — size² term add karke better curve fit milta hai jab relation straight line nahi hoti.","lineHeight":1.25},

